# Keep real keys out of this file and out of Unity/WebGL builds.
# Copy to Backend/.env and fill in. Backend/.env is gitignored.

OPENAI_API_KEY=replace-with-a-server-side-project-key

# These must be real model IDs your key can reach. The server checks them
# against /v1/models at startup and prints a loud error if one is missing.
# Verify with: curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
# Text tutor (gpt-4o-mini is fast, cheap, and widely available):
OPENAI_MODEL=gpt-4o-mini
# OpenAI Realtime WebRTC model (only used when VOICE_MODE=realtime):
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# Model used to transcribe the learner's recorded voice turn:
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_VOICE=shimmer

# Voice input. transcribe (default): the browser records each turn, the
# speech-to-text model transcribes it, the text tutor answers, and the reply
# is spoken by the text-to-speech model. realtime: OpenAI Realtime WebRTC.
VOICE_MODE=transcribe
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Testing only: 1 saves every recorded turn and its transcript to
# Desktop/MetabookVoiceDebug (or VOICE_DEBUG_DIR). Leave empty in production.
VOICE_DEBUG=

PORT=8787
WEBGL_ROOT=../Build/WebGL

# Use "*" for local development only. Set a real origin before hosting.
CORS_ORIGIN=*

# Answer bank: every answer the tutor gives is remembered in Backend/answer-bank.json,
# so the same question asked again is returned instantly and costs no API call.
# Edit that file to correct or curate answers. ANSWER_BANK=0 turns it off.
ANSWER_BANK=1
ANSWER_BANK_LIMIT=5000

# Set on the public host. Keep private and do not include in shared URLs.
ACCESS_CODE=
