# Solaris tutor backend (server.mjs). Keep real keys out of this file and out of Unity/WebGL builds.
# For local runs copy it to Backend/.env (gitignored); on Render set the same names under the
# service's Environment tab. Only the server ever reads these keys: nothing here reaches the page.

# ---- Answers: which provider serves the lesson (Docs/GROQ_MIGRATION.md)
# groq    = Groq Whisper large v3 (speech to text) + openai/gpt-oss-120b (answers)   <- primary
# gemini  = the previous Gemini Live pipeline, kept for rollback
# offline = no AI: the player answers from its own knowledge bank
# Empty: groq when GROQ_API_KEY is set, else gemini when GEMINI_API_KEY is set, else offline.
# AI_PROVIDER=groq

# Required for groq: the Groq API key (console.groq.com, starts with gsk_).
# The free tier allows about 30 questions a minute and 8,000 tokens a minute on GPT-OSS 120B,
# which one busy classroom exceeds: use a paid (Developer) Groq plan for real lessons.
GROQ_API_KEY=

# Optional Groq overrides (the defaults are the tested ones).
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_REASONING_EFFORT=low        # low | medium | high
# GROQ_MAX_RETRIES=1               # 0-2; only timeouts, network errors, 408, 429 and 5xx are retried
# STT_TIMEOUT_MS=8000              # speech to text, per attempt
# LLM_FIRST_TOKEN_MS=8000          # the first words of an answer
# LLM_TOTAL_MS=15000               # the whole answer

# ---- Speech (what Solaris says aloud)
# Empty: groq with AI_PROVIDER=groq, gemini with AI_PROVIDER=gemini.
# groq   = Groq Orpheus (canopylabs/orpheus-v1-english). The first time, Groq may ask the account to
#          accept the Orpheus terms once at https://console.groq.com/playground?model=canopylabs/orpheus-v1-english
#          (the server log says so; until then Solaris speaks with the browser's voice).
# gemini = Gemini text to speech (needs GEMINI_API_KEY), the voice before the migration
# none   = the page speaks with the browser's voice
# TTS_PROVIDER=
# GROQ_TTS_VOICE=hannah    # autumn, diana, hannah, austin, daniel or troy

# ---- Gemini (rollback with AI_PROVIDER=gemini, and speech while TTS_PROVIDER=gemini)
GEMINI_API_KEY=
# GEMINI_VOICE=Leda
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_WORDS_MODEL=gemini-3.5-transcribe-live
# LIVE_WORDS=1            # 0 turns off the second live session that shows the learner's words as they speak
# VOICE_MODE=realtime     # transcribe = the older record-then-answer voice

# The page is on GitHub Pages; https://vaibhavgit31.github.io and localhost are always allowed.
# Add more origins here, comma separated.
# CORS_ORIGIN=

# Optional: an access code learners' links must carry (?code=...). Off when empty. Recommended
# before a classroom rollout, since anyone who finds the page can otherwise use the key's quota.
# ACCESS_CODE=

# Answer bank and speech cache.
# ANSWER_BANK=1
# ANSWER_BANK_LIMIT=2000
# SPEECH_CACHE_MB=64
# KNOWLEDGE_BANK_PATH=../Assets/AIAdaptiveLearning/Resources/Solaris/knowledge-bank.json

# Testing only: saves recorded voice turns to VOICE_DEBUG_DIR.
# VOICE_DEBUG=

# PORT=8787
# WEBGL_ROOT=../Build/WebGL
