# Solaris tutor backend (server.mjs) on Google Gemini. Keep real keys out of this file and out of
# Unity/WebGL builds. For local runs copy it to Backend/.env (gitignored); on Render set the same
# names under the service's Environment tab.

# Required: the Gemini API key (Google AI Studio). Only the server ever sees it: browsers get
# short-lived Live tokens from /api/realtime/session.
GEMINI_API_KEY=

# Optional overrides (the defaults are what the site was tuned and tested with).
# GEMINI_VOICE=Leda
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_WORDS_MODEL=gemini-3.5-transcribe-live
# LIVE_WORDS=1            # 0 turns off the second live session that shows the learner's words as they speak
# VOICE_MODE=realtime     # transcribe = the older record-then-answer voice

# The page is on GitHub Pages; https://vaibhavgit31.github.io and localhost are always allowed.
# Add more origins here, comma separated.
# CORS_ORIGIN=

# Optional: an access code learners' links must carry (?code=...). Off when empty. Recommended
# before a classroom rollout, since anyone who finds the page can otherwise use the key's quota.
# ACCESS_CODE=

# Answer bank and speech cache.
# ANSWER_BANK=1
# ANSWER_BANK_LIMIT=2000
# SPEECH_CACHE_MB=64

# Testing only: saves recorded voice turns to VOICE_DEBUG_DIR.
# VOICE_DEBUG=

# PORT=8787
# WEBGL_ROOT=../Build/WebGL
